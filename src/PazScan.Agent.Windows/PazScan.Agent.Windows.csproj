<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Windows build (and its cross-publish) run on macOS and Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PazScanAgent</AssemblyName>
    <RootNamespace>PazScan.Agent.Windows</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- x64 so the worker package copies NAPS2.Worker.exe, the 32-bit process most TWAIN drivers need. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- NAPS2 and WinForms ship forty translations; the agent's few strings are English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PazScan.Core\PazScan.Core.csproj" />
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.4.0" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
