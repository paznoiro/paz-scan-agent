<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PazScanAgent</AssemblyName>
    <RootNamespace>PazScan.Agent.Desktop</RootNamespace>
    <!-- The agent's few strings are English; NAPS2 and ASP.NET Core ship dozens of translations. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\PazScan.Core\PazScan.Core.csproj" />
    <!-- ImageSharp is managed-only, so the same build runs on macOS and Linux without GDI or GTK. -->
    <PackageReference Include="NAPS2.Images.ImageSharp" Version="1.4.0" />
    <!-- NAPS2 1.4.0 pins ImageSharp 3.1.11. The advisories below are fixed only in ImageSharp
         4.1.2, which requires a paid Six Labors licence and is not usable here. The agent only
         decodes images produced by scanner drivers, never arbitrary uploaded files. Remove these
         suppressions when NAPS2 ships a patched ImageSharp. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <!-- Precompiled SANE for macOS. Linux uses the system SANE libraries instead. -->
    <PackageReference Include="NAPS2.Sane.Binaries" Version="1.2.3"
                      Condition="$(RuntimeIdentifier.StartsWith('osx-')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))" />
  </ItemGroup>

  <!-- The tray icon (TrayIcon.cs), a small program copied beside the agent on build and publish.
       Which one depends on the platform being built for, not the one building. -->
  <PropertyGroup>
    <TrayRid>$(RuntimeIdentifier)</TrayRid>
    <TrayRid Condition="'$(TrayRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</TrayRid>
    <MenuBarSwiftTarget Condition="'$(TrayRid)' == 'osx-arm64'">arm64-apple-macos12.0</MenuBarSwiftTarget>
    <MenuBarSwiftTarget Condition="'$(TrayRid)' == 'osx-x64'">x86_64-apple-macos12.0</MenuBarSwiftTarget>
    <BuildMenuBar Condition="'$(MenuBarSwiftTarget)' != '' And $([MSBuild]::IsOSPlatform('OSX'))">true</BuildMenuBar>
  </PropertyGroup>

  <!-- Linux: PazScanTray.py (GTK 3 and AppIndicator, run with python3) and its icon. Nothing to
       compile, so a Linux build made on any OS has it. -->
  <ItemGroup Condition="$(TrayRid.StartsWith('linux-'))">
    <None Include="Tray/linux/PazScanTray.py" Link="PazScanTray.py"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../assets/icon.png" Link="paz-scan-agent.png"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- macOS: PazScanMenuBar, an AppKit program built from Tray/macos/*.swift for the agent's own
       architecture. It needs swiftc from the Xcode Command Line Tools, so it is built on a Mac only. -->
  <ItemGroup>
    <MenuBarSource Include="Tray/macos/*.swift" />
  </ItemGroup>

  <Target Name="CompileMenuBar" Condition="'$(BuildMenuBar)' == 'true'"
          Inputs="@(MenuBarSource);$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)PazScanMenuBar">
    <Exec Command="xcrun --sdk macosx --find swiftc" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="SwiftcProbe" />
    </Exec>
    <Error Condition="'$(SwiftcProbe)' != '0'"
           Text="The macOS menu bar icon is built with swiftc from the Xcode Command Line Tools. Install them with: xcode-select --install" />
    <!-- Language mode pinned so a newer swiftc builds the same program. The linker signs only
         arm64 binaries, so sign it here like every other native binary in the app (ad hoc). -->
    <Exec Command="xcrun --sdk macosx swiftc -swift-version 5 -O -target $(MenuBarSwiftTarget) -o &quot;$(IntermediateOutputPath)PazScanMenuBar&quot; @(MenuBarSource->'&quot;%(FullPath)&quot;', ' ')" />
    <Exec Command="codesign --force --sign - &quot;$(IntermediateOutputPath)PazScanMenuBar&quot;" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

  <Target Name="CopyMenuBar" Condition="'$(BuildMenuBar)' == 'true'" DependsOnTargets="CompileMenuBar"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)PazScanMenuBar" Link="PazScanMenuBar"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(IntermediateOutputPath)PazScanMenuBar" />
    </ItemGroup>
  </Target>

</Project>
